# ============================================================
# Rincón Realty — Variables de entorno
# Copia este archivo como .env.local y rellena los valores
# NUNCA subas .env.local al repositorio
# ============================================================

# ------------------------------------------------------------
# Supabase — https://supabase.com/dashboard/project/_/settings/api
# ------------------------------------------------------------
# URL pública del proyecto Supabase (seguro exponer al cliente)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Clave anónima pública (seguro exponer al cliente, respeta RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Clave de service role — SOLO usar en server-side (API routes)
# NUNCA exponer al navegador
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------
# Google Maps — https://console.cloud.google.com/apis/credentials
# ------------------------------------------------------------
# Clave de API de Google Maps (habilitar Maps JavaScript API)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# ------------------------------------------------------------
# Resend — https://resend.com/api-keys
# ------------------------------------------------------------
# Clave de API de Resend para envío de emails
RESEND_API_KEY=re_your-resend-api-key-here

# Email del administrador que recibe todas las notificaciones de leads
ADMIN_EMAIL=admin@rinconrealty.com

# ------------------------------------------------------------
# Sitio
# ------------------------------------------------------------
# URL canónica del sitio (sin trailing slash)
# Ejemplo: https://www.rinconrealty.com
NEXT_PUBLIC_SITE_URL=https://www.rinconrealty.com

# Número de WhatsApp de la empresa (formato internacional sin + ni espacios)
# Ejemplo: 50688888888 (Costa Rica +506 8888-8888)
NEXT_PUBLIC_WHATSAPP_NUMBER=50688888888
